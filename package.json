{
  "name": "@np_makin/practicaldocs",
  "version": "11.1.0",
  "description": "PracticalDocs is a document editor for long, page-accurate documents - theses and reports - built on Vue 3 and Tiptap. It is based on Umo Editor by Umodoc (MIT), with its own pagination engine, numbering profiles and PDF tooling.",
  "keywords": [
    "docs editor",
    "document editor",
    "editor",
    "office edtior",
    "online office",
    "richtext editor",
    "tiptap",
    "tiptap3",
    "umo editor",
    "umodoc editor",
    "vue editor",
    "vue3 editor",
    "web editor",
    "web office",
    "word editor",
    "wysiwyg editor"
  ],
  "bugs": {
    "url": "https://github.com/imakin/umodoc-practical/issues"
  },
  "license": "MIT",
  "author": {
    "name": "makin",
    "email": "makin.public@gmail.com"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/practicaldocs.js"
    },
    "./style": {
      "import": "./dist/practicaldocs.css"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 9000 --open --force",
    "package": "npm run build && npm pack",
    "server": "npm --prefix storage-server start",
    "server:dev": "npm --prefix storage-server run dev",
    "test:e2e:full-cdp-audit": "node tests/e2e/test-comprehensive-e2e.cdp.mjs",
    "test:e2e:render-markdown": "node tests/e2e/render-markdown.cdp.mjs",
    "test:e2e:document-references": "node tests/e2e/document-references.cdp.mjs",
    "test:e2e:cross-reference-styling": "node tests/e2e/cross-reference-styling.cdp.mjs",
    "test:e2e:profile-strip-layout": "node tests/e2e/profile-strip-layout.cdp.mjs",
    "test:e2e:autosave-blank-guard": "node tests/e2e/autosave-blank-guard.cdp.mjs",
    "test:e2e:pagination": "node tests/e2e/pagination-geometry.cdp.mjs",
    "test:e2e:sheet-drift": "node tests/e2e/sheet-drift.cdp.mjs",
    "test:e2e:pagination-pdf": "node tests/e2e/pagination-pdf-parity.cdp.mjs",
    "test:e2e:page-break": "node tests/e2e/page-break.cdp.mjs",
    "test:e2e:page-sections": "node tests/e2e/page-sections.cdp.mjs",
    "test:e2e:page-sections-export": "node tests/e2e/page-sections-export.cdp.mjs",
    "test:e2e:page-numbers-export": "node tests/e2e/page-numbers-export.cdp.mjs",
    "test:e2e:document-assets": "node tests/e2e/document-assets.cdp.mjs",
    "test:e2e:document-assets-saveas": "node tests/e2e/document-assets-saveas.cdp.mjs",
    "test:e2e:profile-save": "node tests/e2e/profile-save.cdp.mjs",
    "test:e2e:document-stylesheet": "node tests/e2e/document-stylesheet.cdp.mjs",
    "test:e2e:block-overrides": "node tests/e2e/block-overrides.cdp.mjs",
    "test:e2e:text-case": "node tests/e2e/text-case.cdp.mjs",
    "test:e2e:table-caption": "node tests/e2e/table-caption-removal.cdp.mjs",
    "test:e2e:cell-borders": "node tests/e2e/cell-borders.cdp.mjs",
    "test:e2e:column-divider": "node tests/e2e/column-divider.cdp.mjs",
    "test:e2e:layout-timing": "node tests/e2e/layout-timing.cdp.mjs",
    "test:e2e:profile-margins": "node tests/e2e/profile-margins.cdp.mjs",
    "test:e2e:toc": "node tests/e2e/toc-page-numbers.cdp.mjs",
    "test:e2e:toc-boundaries": "node tests/e2e/toc-boundaries.cdp.mjs",
    "test:e2e:profiles-dialog": "node tests/e2e/profiles-dialog.cdp.mjs",
    "test:unit:document-references": "node --test tests/unit/document-references.test.mjs",
    "test:unit:document-file": "node --test tests/unit/document-file.test.mjs",
    "test:unit:profile-stylesheet": "node --test tests/unit/profile-stylesheet.test.mjs",
    "test:unit:page-numbering": "node --test tests/unit/page-numbering.test.mjs",
    "test:unit:page-sections": "node --test tests/unit/page-sections.test.mjs",
    "test:unit:text-case": "node --test tests/unit/text-case.test.mjs",
    "test:unit:toc-indent": "node --test tests/unit/toc-indent.test.mjs",
    "test:unit:active-profile": "node --test tests/unit/active-profile.test.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix src",
    "analyzer": "vite-bundle-visualizer",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test:e2e:markdown-block": "node tests/e2e/markdown-block.cdp.mjs",
    "test:e2e:markdown-block-styling": "node tests/e2e/markdown-block-styling.cdp.mjs",
    "test:unit:markdown": "node --test tests/unit/markdown.test.mjs",
    "test:e2e:profile-switch": "node tests/e2e/profile-switch.cdp.mjs",
    "test:e2e:page-number-section": "node tests/e2e/page-number-section.cdp.mjs",
    "test:e2e:list-word-break": "node tests/e2e/list-word-break.cdp.mjs",
    "test:e2e:list-numbering": "node tests/e2e/list-numbering.cdp.mjs",
    "test:e2e:list-marker-font": "node tests/e2e/list-marker-font.cdp.mjs",
    "test:e2e:block-pagination": "node tests/e2e/block-pagination.cdp.mjs",
    "test:e2e:pdf-bookmarks": "node tests/e2e/pdf-bookmarks.cdp.mjs",
    "test:unit:pdf-outline": "node --test tests/unit/pdf-outline.test.mjs"
  },
  "dependencies": {
    "@eslint/object-schema": "3.0.2",
    "@floating-ui/dom": "1.7.5",
    "@tiptap/core": "3.20.0",
    "@tiptap/extension-bold": "3.20.0",
    "@tiptap/extension-code-block": "3.20.0",
    "@tiptap/extension-code-block-lowlight": "3.20.0",
    "@tiptap/extension-collaboration": "3.20.0",
    "@tiptap/extension-details": "3.20.0",
    "@tiptap/extension-document": "3.20.0",
