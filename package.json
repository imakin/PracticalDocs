    "husky": "^9.1.7",
    "less": "^4.5.1",
    "less-loader": "^12.3.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "tdesign-vue-next": "1.18.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue": "^7.1.1",
    "unplugin-vue-components": "^31.0.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.5.29",
    "ws": "8.18.3"
  },
  "overrides": {
    "rolldown": "^1.1.3"
  },
  "lint-staged": {
    "*.{js,vue,less}": [
      "oxfmt --write src",
      "oxlint --fix src"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "homepage": "https://github.com/imakin/umodoc-practical",
