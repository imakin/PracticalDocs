    "es-drager": "1.2.11",
    "fast-glob": "3.3.3",
    "file-saver": "2.0.5",
    "hotkeys-js": "4.0.2",
    "jsbarcode": "3.12.3",
    "katex": "0.16.33",
    "lowlight": "3.3.0",
    "markdown-it": "14.3.0",
    "nzh": "1.0.14",
    "pdf-lib": "^1.17.1",
    "pretty-bytes": "7.1.0",
    "pure-svg-code": "1.0.6",
    "smooth-signature": "1.0.15",
